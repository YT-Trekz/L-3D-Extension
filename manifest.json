{
  "id": "lommel",
  "name": "L-3D Extension",
  "version": "1.0.0",
  "author": "LOMMEL",
  "model": "MyModel",
  "description": "Generates 3D meshes from images or prompts.",
  "generator_class": "L3DGenerator",
  "repository": "https://github.com/YT-Trekz/L-3D-Extension",
  "variants": [
    { "id": "base", "label": "Base", "url": "https://huggingface.co/..." },
    { "id": "fast", "label": "Fast", "url": "https://huggingface.co/..." }
  ],
  "nodes": [
    {
      "id": "generate",
      "name": "Generate Mesh",
      "inputs": [
        { "name": "image", "type": "image" }
      ],
      "outputs": [
        { "name": "mesh", "type": "mesh" }
      ],
      "params_schema": [
        {
          "id": "slat_steps",
          "label": "Shape Steps",
          "type": "int",
          "default": 25,
          "min": 1,
          "max": 50,
          "tooltip": "Diffusion steps for the geometry SLaT (fine details)."
        }
      ]
    }
  ]
}
