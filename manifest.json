{
  "id": "lommel",
  "name": "L-3D Extension",
  "version": "1.0.0",
  "author": "LOMMEL",
  "model": "MyModel",
  "description": "Generates 3D meshes from images or prompts.",
  "generator_class": "L-3DGenerator",
  "repository": "https://github.com/YT-Trekz/L-3D-Extension",
  "variants": [
    { 
      "id": "turbo", 
      "label": "Hunyuan3D 2 Mini Turbo (Aanbevolen)", 
      "url": "https://huggingface.co" 
    }
  ],
  "nodes": [
    {
      "id": "generate",
      "name": "Generate Mesh",
      "input": "image",
      "output": "mesh",
      "params_schema": [
        {
          "id": "slat_steps",
          "label": "Shape Steps",
          "type": "int",
          "default": 5,
          "min": 1,
          "max": 25,
          "tooltip": "Aantal stappen voor de Turbo-generatie (5 is optimaal)."
        }
      ]
    }
  ]
}
